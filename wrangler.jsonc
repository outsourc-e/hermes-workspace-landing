{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hermes-workspace-landing",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "routes": [{"pattern":"hermes-workspace.com","custom_domain":true},{"pattern":"www.hermes-workspace.com","custom_domain":true}],
  "assets": { "directory": "./out", "html_handling": "auto-trailing-slash", "not_found_handling": "404-page" }
}
